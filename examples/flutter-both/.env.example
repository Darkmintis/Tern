# Combined env example — Android + iOS.
# Prefer separate secret stores per platform in real CI.

# --- Android / Play ---
ANDROID_KEYSTORE=/absolute/path/to/upload-keystore.jks
ANDROID_KEYSTORE_PASSWORD=replace-me
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=replace-me
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/play-service-account.json

# --- iOS / TestFlight ---
IOS_CERT=/absolute/path/to/distribution.p12
APP_STORE_CONNECT_API_KEY_ID=XXXXXXXXXX
APP_STORE_CONNECT_API_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_STORE_CONNECT_API_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
