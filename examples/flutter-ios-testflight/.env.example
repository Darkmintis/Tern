# iOS / App Store Connect — do NOT commit real secrets.

# Path Tern doctor can validate (cert, .p12, or .mobileprovision)
IOS_CERT=/absolute/path/to/distribution.p12

# App Store Connect API key (for altool upload)
APP_STORE_CONNECT_API_KEY_ID=XXXXXXXXXX
APP_STORE_CONNECT_API_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_STORE_CONNECT_API_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
